{
  "expo": {
    "name": "OrganizApp",
    "slug": "organizapp",
    "version": "1.0.3",
    "orientation": "portrait",
    "scheme": "organizapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.wizeorganizapp",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wizeorganizapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo_marca_clara.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A1A2E"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6C5CE7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d38fb802-0d74-4355-b037-9805528e4e53"
      }
    }
  }
}
